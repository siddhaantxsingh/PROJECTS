# Paths used by flow/scripts/pd_lite.sh on the machine where the results in
# flow/results/ were produced (scratch directories; adjust for yours).
P=/path/to/pdk
export LIB=$P/sky130hd_tt_nodontuse.lib      # lib_dont_use.py sky130_fd_sc_hd__tt_025C_1v80.lib
export TLEF=$P/lef/sky130_fd_sc_hd.tlef       # ORFS flow/platforms/sky130hd/lef/
export LEF=$P/lef/sky130_fd_sc_hd_merged.lef
export SETRC=$P/lef/setRC.tcl                 # ORFS flow/platforms/sky130hd/setRC.tcl
export OPENROAD=/path/to/conda-env/bin/openroad   # micromamba create -c litex-hub -c conda-forge openroad
